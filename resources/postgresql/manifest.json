{
  "major": 15,
  "minor": "15.19",
  "distribution": "postgresql-binaries",
  "version": "15.19.1",
  "targets": {
    "macos-arm64": {
      "source": "theseus-rs/postgresql-binaries",
      "asset": "postgresql-15.19.1-aarch64-apple-darwin.tar.gz",
      "sha256": "",
      "size_mb_approx": 108
    },
    "macos-x64": {
      "source": "theseus-rs/postgresql-binaries",
      "asset": "postgresql-15.19.1-x86_64-apple-darwin.tar.gz",
      "sha256": "",
      "size_mb_approx": 104
    },
    "windows-x64": {
      "source": "theseus-rs/postgresql-binaries",
      "asset": "postgresql-15.19.1-x86_64-pc-windows-msvc.tar.gz",
      "sha256": "",
      "size_mb_approx": 110
    },
    "linux-x64": {
      "source": "build-from-source",
      "asset": "postgresql-15.19-linux-x64.tar.gz",
      "sha256": "",
      "size_mb_approx": 22,
      "build_options": ["--without-icu", "--without-readline"]
    }
  },
  "binaries": [
    "postgres",
    "initdb",
    "pg_ctl",
    "pg_isready",
    "psql",
    "pg_dump",
    "pg_restore"
  ],
  "libraries": [
    "libpq",
    "libicu (macOS/Windows)",
    "libssl",
    "libcrypto",
    "libxml2",
    "zlib",
    "lz4",
    "zstd"
  ],
  "license": "PostgreSQL License (permissiva, stile BSD/MIT)",
  "notices": [
    "PostgreSQL: https://www.postgresql.org/about/licence/",
    "theseus-rs: https://github.com/theseus-rs/postgresql-binaries",
    "ICU: Unicode License",
    "OpenSSL: Apache-2.0",
    "libxml2: MIT",
    "zlib: zlib License",
    "lz4: BSD-2-Clause",
    "zstd: BSD-3-Clause"
  ],
  "layout": {
    "bin": "bin/",
    "lib": "lib/",
    "share": "share/"
  },
  "notes": [
    "I binari sono scaricati/verificati in CI (ADR-0004 §2.2)",
    "SHA-256 viene popolato dallo script di download",
    "Linux: build dai sorgenti su ubuntu-22.04 con rpath $ORIGIN",
    "Esclusi: include/, symbols/, .a statiche, PL/Python, documentazione"
  ]
}
