{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CounselorBot Docente",
  "mainBinaryName": "counselorbot-teacher",
  "version": "0.1.2",
  "identifier": "org.ai4educ.counselorbot.teacher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0OUVGNDc0NkZBNkU2RDcKUldUWDVxWnZkUFNlcERHV2cyYno4bjZBclFuQk13Z1FLMWdlVm9zb3JjYkx6Y3VuRCtLSitjWWU=",
      "endpoints": [
        "https://github.com/nugh75/counselorbot-sbs/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "backend/": "backend/",
      "frontend/": "frontend/",
      "node/": "node/",
      "cloudflared/": "cloudflared/",
      "postgresql/": "postgresql/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {}
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
