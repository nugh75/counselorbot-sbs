# Ambiente di SVILUPPO locale (next dev). Caricato automaticamente da Next.js
# solo con `npm run dev`; la produzione usa il Dockerfile e non lo legge.
# /api/* viene inoltrato al FastAPI di sviluppo sull'host (porta 8001,
# NON la 8088 del container di produzione, né la 8001 — occupata da un altro servizio).
BACKEND_ORIGIN=http://127.0.0.1:8002
