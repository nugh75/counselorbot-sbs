# Managed by CounselorBot scripts/register-portable-herder.mjs.
# Authentication and access groups are maintained by the existing Console.
# Herder service - uses explicit IPv4 to avoid IPv6 ULA resolution issues
server {
    listen 80;
    server_name {{HOSTNAME}};
    client_max_body_size 100m;
    # Resolve the herder service at request time using IPv4 only
    # to avoid IPv6 ULA (fdc4:f303:9324::254) resolution issues
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $herder_upstream http://127.0.0.1:7317;

    location / {
        proxy_pass $herder_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 30s;
        proxy_buffering off;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
