# Managed by CounselorBot scripts/register-portable-console.mjs.
# Authentication and access groups are maintained by the existing Console.
server {
    listen 80;
    server_name {{HOSTNAME}};
    client_max_body_size 100m;
    # Resolve the separate app at request time so its downtime does not
    # prevent the existing Console nginx from starting or reloading.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $counselorbot_upstream http://{{FRONTEND}}:3000;

    location = /internal/ai4auth/verify {
        internal;
        proxy_pass http://{{AUTH_UPSTREAM}}/api/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URL https://$http_host$request_uri;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie $http_cookie;
        # Bound the auth subrequest (issue #254): with the 60s defaults a hung
        # ai4auth tied up one worker per request for a minute and then answered
        # 500. A session verify is a fast local call: connect/send fail fast,
        # while read tolerates a slow-but-alive ai4auth. When the subrequest
        # still fails, `location /` maps the resulting 500 to a readable 503.
        proxy_connect_timeout 15s;
        proxy_send_timeout 15s;
        proxy_read_timeout 90s;
    }

    location = /api/chatgpt/link/parameters {
        # The short-lived pairing Bearer authorizes only this transfer. The
        # local helper has no Console session; all other paths retain SSO.
        limit_except GET { deny all; }
        client_max_body_size 128k;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Groups "";
        proxy_set_header Remote-Email "";
        proxy_set_header Remote-Name "";
        proxy_set_header Remote-Service-Permission "";
        proxy_set_header X-Forwarded-Auth-Secret "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_buffering off;
        proxy_pass $counselorbot_upstream;
    }

    location = /api/chatgpt/link/registration {
        # The short-lived pairing Bearer authorizes only this transfer. The
        # local helper has no Console session; all other paths retain SSO.
        limit_except POST { deny all; }
        client_max_body_size 128k;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Groups "";
        proxy_set_header Remote-Email "";
        proxy_set_header Remote-Name "";
        proxy_set_header Remote-Service-Permission "";
        proxy_set_header X-Forwarded-Auth-Secret "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_buffering off;
        proxy_pass $counselorbot_upstream;
    }

    location = /api/chatgpt/link/complete {
        # The short-lived pairing Bearer authorizes only this transfer. The
        # local helper has no Console session; all other paths retain SSO.
        limit_except POST { deny all; }
        client_max_body_size 128k;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Groups "";
        proxy_set_header Remote-Email "";
        proxy_set_header Remote-Name "";
        proxy_set_header Remote-Service-Permission "";
        proxy_set_header X-Forwarded-Auth-Secret "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_buffering off;
        proxy_pass $counselorbot_upstream;
    }

    location / {
        auth_request /internal/ai4auth/verify;
        error_page 401 =302 https://{{AUTH_HOST}}/login?rd=https://$http_host$request_uri;
        error_page 403 =302 https://{{PORTAL_HOST}}/;
        # Any other auth subrequest outcome (ai4auth unreachable, timed out or
        # answering 5xx) is reported by the auth_request module as 500. Answer
        # with a readable, retryable 503 instead; recovery is automatic as
        # soon as ai4auth responds again (per-request timeouts, upstream DNS
        # re-resolved every 30s).
        error_page 500 = @auth_unavailable;
        # The backend independently verifies the session cookie with ai4auth.
        # Drop client-supplied identities and the optional shared-secret header.
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Groups "";
        proxy_set_header Remote-Email "";
        proxy_set_header Remote-Name "";
        proxy_set_header Remote-Service-Permission "";
        proxy_set_header X-Forwarded-Auth-Secret "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 30s;
        proxy_buffering off;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_pass $counselorbot_upstream;
    }

    # Reached only through the error_page redirect above. It has no
    # auth_request of its own, so answering an auth failure cannot loop.
    location @auth_unavailable {
        internal;
        default_type text/plain;
        charset utf-8;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
        return 503 "Autenticazione temporaneamente non disponibile: riprova tra qualche istante.\nAuthentication temporarily unavailable: please retry in a few moments.\n";
    }
}
