# Database
POSTGRES_USER=counselorbot_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=counselorbot
# Utility lanciate dall'host (`migrate_data.py`, `check_sequences.py`)
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5435

# JWT Secret (genera con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me

# API Keys dei provider AI (lascia vuoto se non usi il provider)
# In produzione sono assegnate da ai4educ Console → Segreti e lette solo dall'ambiente.
API_KEY_OPENAI=
# Personal ChatGPT plan: enable from Administration > General > ChatGPT connection.
# Optional initial setting only; the saved admin choice takes precedence.
# Check SIWC eligibility: docs/operations/chatgpt-subscription.md.
CHATGPT_ENABLED=false
CHATGPT_CREDENTIAL_KEY=
# Optional operator-managed protected file; takes precedence over the key above.
# Leave both blank to create a persistent private key automatically from the admin panel.
CHATGPT_CREDENTIAL_KEY_FILE=
# Optional directory for the automatic key; default is ./chatgpt_credentials.
CHATGPT_CREDENTIALS_DIR=
# Optional directory containing CounselorBot-ChatGPT.zip for authenticated Mac downloads.
# Default: ./dist/chatgpt-macos; portable Compose mounts it read-only automatically.
CHATGPT_MACOS_HELPER_DIR=
API_KEY_ANTHROPIC=
API_KEY_GEMINI=
# Recupero documenti senza Ollama: gli embedding esterni riusano queste due chiavi
# di sistema (Mistral diretto, oppure OpenRouter; accettata anche OPENROUTER_API_KEY).
# Provider, modello e modalità si scelgono in Amministrazione → Recupero documenti.
# Procedura: docs/operations/portable-installation.md#recupero-documenti-senza-ollama
API_KEY_MISTRAL=
API_KEY_OPENROUTER=
# OmniRoute: gateway access key when required, managed by ai4educ Console.
OMNIROUTE_API_KEY=
OMNIROUTE_API_URL=http://omniroute:20128/v1
API_KEY_GROQ=
API_KEY_CEREBRAS=
API_KEY_DEEPSEEK=
API_KEY_TOGETHER=
API_KEY_FIREWORKS=
API_KEY_DEEPINFRA=
OLLAMA_BASE_URL=
# Privacy P6a-c: only loopback is trusted automatically. Declare exact hosts
# managed by this installation (comma/space separated, no URL/port/wildcard).
# Docker example: piper,host.docker.internal; add ollama only if it is your service.
PRIVACY_LOCAL_HOSTS=piper,host.docker.internal
# Optional alias, additive to PRIVACY_LOCAL_HOSTS.
TRUSTED_LOCAL_HOSTS=
# Privacy P6 AI gateway: transitional (default until P7/P8 events/P9) or strict.
# strict blocks every AI call without configured purposes, grants, audit and P4 model.
PRIVACY_GATEWAY_MODE=transitional
# Local Piper HTTP service; must be loopback or explicitly trusted above.
PIPER_URL=http://piper:8000
# Runtime locale: 8k e permanenza breve limitano KV cache/VRAM.
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=5m
OLLAMA_PRELOAD=false
# Traduzioni editoriali (catalogo certificato, strumenti, counselor): opzionali.
# Senza preset usano il provider e il modello attivi in Amministrazione.
# TRANSLATION_PROVIDER=mistral
# TRANSLATION_MODEL=mistral-large-latest
# COUNSELOR_TRANSLATE_DISABLED=1
# Server locale / compatibile OpenAI: llama.cpp, llama-swap, LM Studio, vLLM, LiteLLM
# (con o senza /v1 finale). In Docker 127.0.0.1 e' il container: per un server
# sul computer host usare http://host.docker.internal:<porta>.
LLAMACPP_BASE_URL=
# Chiave facoltativa del server compatibile (vLLM/LiteLLM protetti): e' un segreto,
# va impostata in ai4educ Console, pagina Segreti. Vuota = nessuna chiave.
LLAMACPP_API_KEY=
# Il context di llama.cpp si fissa all'avvio del server, non nella richiesta:
# esempio: llama-server ... --ctx-size 8192

# Knowledge base collettiva: vengono iniettate solo strategie marcate approved.
STRATEGY_MEMORY_FILE=/app/knowledge/approved_strategies.md

# Estrazione locale QSA via Ollama. Il ripiego vision_provider/vision_model
# ammette solo Ollama su host fidato: immagini verso provider esterni bloccate.
QSA_OCR_MODEL=glm-ocr:latest
QSA_PARSER_MODEL=qwen3.8:latest

# --- Auth (ai4auth forward-auth) ---
# L'autenticazione avviene al bordo (nginx auth_request -> ai4auth /verify),
# che inietta gli header Remote-User/Remote-Email/Remote-Groups.
# Fornitore di identità: ai4auth (default, server/Console) oppure local (solo app
# desktop docente, ADR-0002 §3: sessioni cb_session, niente header Remote-*).
AUTH_PROVIDER=ai4auth
# Profilo di installazione: vuoto su server/Console; teacher-pc (impostato dal
# guscio desktop) richiede AUTH_PROVIDER=local e disattiva le funzioni di laboratorio.
# COUNSELORBOT_PROFILE=
# Bundle desktop: il guscio imposta profilo, auth, porte e directory; non legge
# questo file (PYTHON_DOTENV_DISABLED=1). Chiavi AI dal portachiavi OS, non da .env.
# Guida e limiti: docs/operations/desktop-teacher-guide.md (F1-17).
# La manutenzione deve usare DATABASE_URL e COUNSELORBOT_BACKUP_DIR del profilo;
# non puntare i test a dati reali. Nessun valore di prova viene abilitato qui.
# Gruppo che abilita la dashboard admin (default: admins)
ADMIN_GROUP=admins
# Fallback sicuro: valida la sessione sulla rete Docker condivisa con ai4auth
# quando il reverse proxy non inoltra ancora il segreto condiviso.
AI4AUTH_VERIFY_URL=http://ai4auth:9091/api/verify
# Hostname pubblico del servizio: ai4auth autorizza per-hostname (access matrix),
# quindi la verifica diretta deve presentarsi con questo Host.
AI4AUTH_PUBLIC_HOST=counselorbot-sbs.ai4educ.org
# Optional Console admin API token for research-contact synchronization only.
# Login does not require this token. Keep the actual value private.
AI4AUTH_ADMIN_TOKEN=
# Deve coincidere con l'header X-Forwarded-Auth-Secret impostato solo dal proxy.
# Se impostato, consente il percorso rapido tramite header autenticati del proxy.
FORWARD_AUTH_SHARED_SECRET=
# Cifratura delle chiavi API personali (Fernet, distinta dalle chiavi provider).
# Facoltativa: la chiave privata viene creata automaticamente attivando API personali da Amministrazione.
# Conservare stabilmente e includere nei backup sicuri; non cambiare dopo aver salvato chiavi.
PERSONAL_API_ENCRYPTION_KEY=
# Override avanzati facoltativi; il valore FILE ha precedenza.
PERSONAL_API_ENCRYPTION_KEY_FILE=
PERSONAL_API_CREDENTIALS_DIR=
# Copia cifrata della password di classe mostrata nel passo di somministrazione.
# Facoltativa: senza chiave usa la chiave gestita nella cartella delle API personali.
# Impostare una chiave dedicata solo se serve separare le due cifrature.
INSTITUTION_CREDENTIAL_KEY=
INSTITUTION_CREDENTIAL_KEY_FILE=
INSTITUTION_CREDENTIALS_DIR=
# Privacy Layer (P5, docs/privacy/p5-crittografia-chiavi.md): chiave radice (KEK) che cifra le chiavi
# dei dati in privacy_keys. 32 byte base64url, generare con
#   python -c "from backend.privacy.keys import generate_kek; print(generate_kek())"
# Impostare solo una delle due; mai nel database o nei backup del DB. Persa la KEK senza kit di recupero,
# i dati cifrati sono persi. Sull'app desktop la passa il guscio dal portachiavi del sistema.
PRIVACY_KEK=
PRIVACY_KEK_FILE=
# Cifratura a riposo dei contenuti (P11, docs/privacy/p11-cifratura-db.md): con on le nuove scritture sono
# cifrate (richiede la KEK); la lettura decifra sempre e restituisce in chiaro i record non ancora cifrati.
PRIVACY_DB_ENCRYPTION=
OPENCODE_CHAT_MODEL=gemma4:12b

# --- Telegram bot (docs/future-implementazione/telegram-chatbot-counselorbot.md) ---
# Token da @BotFather; il webhook secret deve essere 1-256 char [A-Za-z0-9_-].
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_WEBHOOK_URL=https://counselorbot-sbs.ai4educ.org/api/telegram/webhook
TELEGRAM_BOT_ENABLED=false

# --- Consultazione di fonti pubbliche (skill web-lookup) ---
# Wikipedia, Treccani, Open Library e OpenAlex non richiedono credenziali.
# Google Books risponde 429 senza chiave: lasciando questa variabile vuota la
# fonte viene semplicemente saltata, senza chiamate inutili.
GOOGLE_BOOKS_API_KEY=

# Optional isolated prompt lab: use docker-compose.prompt-lab.yml alongside the base file.
# Owner/worker credentials are generated into separate Docker volumes, never this file.
# Defaults target Ollama on the Docker host; only private HTTP endpoints on 11434.
# PROMPT_LAB_OLLAMA_UPSTREAM=http://host.docker.internal:11434
# Change only if this subnet overlaps your own network.
# PROMPT_LAB_EGRESS_SUBNET=10.203.30.0/28
# Native development only: distinct laboratory DB (no production URL).
# PROMPT_LAB_DATABASE_URL_FILE=/path/to/lab-database-url
# PROMPT_LAB_MODEL_URL=http://prompt-lab-model-gateway:8080

# Portable installation (docker-compose.portable.yml, standalone).
# Public URLs are read by the frontend at startup (F1-03): recreate the
# frontend container after changing them, no rebuild needed.
COUNSELORBOT_HOSTNAME=counselorbot.labform.net
COUNSELORBOT_AUTH_URL=https://auth.labform.net
COUNSELORBOT_PORTAL_URL=https://portal.labform.net
COUNSELORBOT_MANAGER_URL=https://manager.labform.net
COUNSELORBOT_CONSOLE_NETWORK=console-platform_default
COUNSELORBOT_FRONTEND_PORT=3108
COUNSELORBOT_BACKEND_PORT=8087
# Optional Docker Hub image mirror when the registry is unreachable.
# COUNSELORBOT_PYTHON_BASE_IMAGE=mirror.gcr.io/library/python:3.10-slim
# COUNSELORBOT_NODE_BASE_IMAGE=mirror.gcr.io/library/node:22-alpine
# COUNSELORBOT_POSTGRES_IMAGE=mirror.gcr.io/library/postgres:15
